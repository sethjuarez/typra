{
  "version": 1,
  "targets": ["typescript", "python", "csharp", "go", "java", "rust", "swift"],
  "rules": [
    {
      "id": "fixture-root-sample-shape",
      "status": "enforced",
      "case": "fixture-root-sample-shape",
      "verification": "fixture-evidence",
      "description": "Generated fixture evidence covers nested objects, scalar arrays, records, enums, open enums, and polymorphic sample fields."
    },
    {
      "id": "polymorphic-content-dispatch",
      "status": "enforced",
      "case": "polymorphic-content-dispatch",
      "verification": "fixture-evidence",
      "description": "Generated fixture evidence covers closed discriminator subtype selection and discriminator-specific serialization."
    },
    {
      "id": "provider-wire-mapping",
      "status": "enforced",
      "case": "provider-wire-mapping",
      "verification": "fixture-evidence",
      "description": "Generated fixture evidence covers provider-specific wire conversion without canonical-name fallback for unmapped providers."
    },
    {
      "id": "scalar-coercion",
      "status": "enforced",
      "case": "scalar-coercion",
      "verification": "fixture-evidence",
      "description": "Generated fixture evidence covers scalar shorthand expansion to the canonical object shape."
    },
    {
      "id": "invalid-discriminator-states",
      "status": "known-gap",
      "issue": "#133",
      "description": "Absent, blank, and wrong-type discriminators need executable cross-target assertions."
    },
    {
      "id": "keyed-collection-ordering",
      "status": "known-gap",
      "issue": "#134",
      "description": "Keyed collection object-form ordering needs a documented and enforced cross-target contract."
    },
    {
      "id": "keyed-collection-ambiguous-names",
      "status": "known-gap",
      "issue": "#49",
      "description": "Duplicate or empty keyed-collection names must be preserved losslessly or rejected consistently."
    },
    {
      "id": "complex-default-required-presence",
      "status": "known-gap",
      "issue": "#125",
      "description": "Defaults on complex properties must not disable required-field enforcement."
    },
    {
      "id": "typed-record-values",
      "status": "known-gap",
      "issue": "#123",
      "description": "Record<T> value types must be preserved and exercised across all targets."
    },
    {
      "id": "java-yaml-escaping",
      "status": "known-gap",
      "issue": "#129",
      "description": "Java YAML escaping and parsing of control/unicode sequences need executable coverage."
    }
  ],
  "cases": [
    {
      "id": "fixture-root-sample-shape",
      "description": "FixtureRoot preserves the same nested object, scalar array, dictionary, enum, open enum, and polymorphic sample shape across targets.",
      "evidence": {
        "json-ast": [
          {
            "path": "generated/fixtures/json-ast/model.json",
            "snippets": [
              "\"name\": \"tags\"",
              "\"name\": \"metadata\"",
              "\"name\": \"owner\"",
              "\"name\": \"content\"",
              "\"value\": \"hello from a polymorphic sample\""
            ]
          }
        ],
        "typescript": [
          {
            "path": "generated/fixtures/typescript/fixture-root.ts",
            "snippets": [
              "instance.tags = (data[\"tags\"] as unknown[]).map",
              "instance.metadata = data[\"metadata\"] as Record<string, unknown>;",
              "instance.owner = FixtureOwner.load",
              "instance.content = FixtureContent.load",
              "result[\"content\"] = obj.content.save(context);"
            ]
          }
        ],
        "python": [
          {
            "path": "generated/fixtures/python/_FixtureRoot.py",
            "snippets": [
              "instance.tags = data[\"tags\"]",
              "instance.metadata = data[\"metadata\"]",
              "instance.owner = FixtureOwner.load",
              "instance.content = FixtureContent.load",
              "result[\"content\"] = obj.content.save(context)"
            ]
          }
        ],
        "csharp": [
          {
            "path": "generated/fixtures/csharp/FixtureRoot.cs",
            "snippets": [
              "instance.Tags = (tagsValue as IEnumerable<object>)?.Select",
              "instance.Metadata = metadataValue.GetDictionary()!;",
              "instance.Owner = FixtureOwner.Load",
              "instance.Content = FixtureContent.Load",
              "result[\"content\"] = obj.Content?.Save(context);"
            ]
          }
        ],
        "go": [
          {
            "path": "generated/fixtures/go/fixture_root.go",
            "snippets": [
              "case []string:",
              "loaded, err := LoadFixtureOwner",
              "loaded, err := LoadFixtureContent",
              "result[\"content\"] = v.Save(ctx)"
            ]
          },
          {
            "path": "generated/fixtures/go/tests/fixture_root_test.go",
            "snippets": [
              "Expected Tags length to be 3",
              "Expected Metadata[\"source\"]",
              "Expected Owner.DisplayName",
              "Expected Content to be fixtures.TextContent"
            ]
          }
        ],
        "java": [
          {
            "path": "generated/fixtures/java/FixtureRoot.java",
            "snippets": [
              "result.tags = new ArrayList<>();",
              "result.metadata = copyMap(dict);",
              "result.owner = FixtureOwner.load",
              "result.content = FixtureContent.load",
              "result.put(\"content\", obj.content.save(ctx))",
              "public String toYaml()",
              "public static FixtureRoot fromYaml(String yaml)"
            ]
          },
          {
            "path": "generated/fixtures/java/tests/FixtureRootGeneratedTest.java",
            "snippets": [
              "Expected content to be TextContent",
              "hello from a polymorphic sample",
              "Expected contentItems[0] to be TextContent",
              "hello from a polymorphic collection",
              "String yamlRoundtrip1 = instance1.toYaml();",
              "FixtureRoot fromYaml1 = FixtureRoot.fromYaml(yamlRoundtrip1);"
            ]
          }
        ],
        "rust": [
          {
            "path": "generated/fixtures/rust/fixture_root.rs",
            "snippets": [
              "tags: value.get(\"tags\")",
              "metadata: value.get(\"metadata\").cloned",
              "owner: value.get(\"owner\")",
              "content: value.get(\"content\").cloned",
              "result.insert(\"content\".to_string(), self.content.clone())"
            ]
          }
        ],
        "swift": [
          {
            "path": "generated/fixtures/swift/Sources/TypraFixtures/fixture_root.swift",
            "snippets": [
              "public var tags: [String] = []",
              "instance.owner = try FixtureOwner.load(value, context: context.at(\"owner\"))",
              "instance.content = try FixtureContent.load(value, context: context.at(\"content\"))",
              "result[\"content\"] = try self.content.save(context)"
            ]
          }
        ]
      }
    },
    {
      "id": "polymorphic-content-dispatch",
      "description": "FixtureContent dispatches the closed text/image/file/audio discriminator consistently and serializes discriminator-specific data.",
      "evidence": {
        "json-ast": [
          {
            "path": "generated/fixtures/json-ast/model.json",
            "snippets": [
              "\"discriminator\": \"kind\"",
              "\"name\": \"TextContent\"",
              "\"name\": \"ImageContent\"",
              "\"name\": \"FileContent\"",
              "\"name\": \"AudioContent\""
            ]
          }
        ],
        "typescript": [
          {
            "path": "generated/fixtures/typescript/fixture-content.ts",
            "snippets": [
              "case \"text\":",
              "return TextContent.load(data, context);",
              "case \"image\":",
              "result[\"value\"] = obj.value;"
            ]
          }
        ],
        "python": [
          {
            "path": "generated/fixtures/python/_FixtureContent.py",
            "snippets": [
              "if discriminator_value == \"text\":",
              "return TextContent.load(data, context)",
              "elif discriminator_value == \"image\":",
              "result[\"value\"] = obj.value"
            ]
          }
        ],
        "csharp": [
          {
            "path": "generated/fixtures/csharp/FixtureContent.cs",
            "snippets": [
              "\"text\" => TextContent.Load(data, context),",
              "\"image\" => ImageContent.Load(data, context),"
            ]
          },
          {
            "path": "generated/fixtures/csharp/TextContent.cs",
            "snippets": [
              "public override Dictionary<string, object?> Save",
              "result[\"value\"] = obj.Value;"
            ]
          }
        ],
        "go": [
          {
            "path": "generated/fixtures/go/fixture_content.go",
            "snippets": [
              "case \"text\":",
              "return LoadTextContent(data, ctx)",
              "case \"image\":",
              "result[\"value\"] = obj.Value"
            ]
          }
        ],
        "java": [
          {
            "path": "generated/fixtures/java/FixtureContent.java",
            "snippets": [
              "case \"text\":",
              "return TextContent.load(data, ctx);",
              "case \"image\":"
            ]
          },
          {
            "path": "generated/fixtures/java/TextContent.java",
            "snippets": [
              "extends FixtureContent",
              "result.put(\"value\", serializeScalar(obj.value));"
            ]
          }
        ],
        "rust": [
          {
            "path": "generated/fixtures/rust/fixture_content.rs",
            "snippets": [
              "FixtureContentKind::TextContent",
              "\"text\" => FixtureContentKind::TextContent",
              "result.insert(\"kind\".to_string()",
              "result.insert(\"value\".to_string()"
            ]
          }
        ],
        "swift": [
          {
            "path": "generated/fixtures/swift/Sources/TypraFixtures/fixture_content.swift",
            "snippets": [
              "case \"text\": return .textContent(try TextContent.load(normalizedData, context: context))",
              "case \"image\": return .imageContent(try ImageContent.load(normalizedData, context: context))",
              "case .textContent(let value): return try value.save(context)"
            ]
          }
        ]
      }
    },
    {
      "id": "provider-wire-mapping",
      "description": "WireOptions maps semantic fields to provider-specific wire names for OpenAI and Anthropic, and omits any field the requested provider does not map. temperature is declared for OpenAI only, so an Anthropic payload must not carry it under any name.",
      "evidence": {
        "typescript": [
          {
            "path": "generated/fixtures/typescript/wire-options.ts",
            "snippets": [
              "toWire(provider: string)",
              "\"maxOutputTokens\": { \"openai\": \"max_completion_tokens\", \"anthropic\": \"max_tokens\" }",
              "\"temperature\": { \"openai\": \"temperature\" }",
              "if (mapping?.[provider]) {",
              "result[mapping[provider]] = value"
            ]
          }
        ],
        "python": [
          {
            "path": "generated/fixtures/python/_WireOptions.py",
            "snippets": [
              "def to_wire(self, provider: str) -> dict[str, Any]:",
              "\"maxOutputTokens\": {\"openai\": \"max_completion_tokens\", \"anthropic\": \"max_tokens\"}",
              "\"temperature\": {\"openai\": \"temperature\"}",
              "if mapping is not None and provider in mapping:",
              "result[mapping[provider]] = value"
            ]
          }
        ],
        "csharp": [
          {
            "path": "generated/fixtures/csharp/WireOptions.cs",
            "snippets": [
              "public Dictionary<string, object?> ToWire(string provider)",
              "[\"maxOutputTokens\"] = new Dictionary<string, string> { [\"openai\"] = \"max_completion_tokens\", [\"anthropic\"] = \"max_tokens\" }",
              "[\"temperature\"] = new Dictionary<string, string> { [\"openai\"] = \"temperature\" }",
              "if (wireMap.TryGetValue(key, out var mapping) && mapping.TryGetValue(provider, out var wireName))",
              "result[wireName] = value;"
            ]
          }
        ],
        "go": [
          {
            "path": "generated/fixtures/go/wire_options.go",
            "snippets": [
              "func (obj *WireOptions) ToWire(provider string) map[string]interface{}",
              "\"maxOutputTokens\": {\"openai\": \"max_completion_tokens\", \"anthropic\": \"max_tokens\"}",
              "\"temperature\": {\"openai\": \"temperature\"}",
              "if wireName, ok := mapping[provider]; ok {",
              "result[wireName] = value"
            ]
          },
          {
            "path": "generated/fixtures/go/tests/wire_options_test.go",
            "snippets": [
              "openaiWire := instance.ToWire(\"openai\")",
              "openaiWire[\"max_completion_tokens\"]",
              "anthropicWire := instance.ToWire(\"anthropic\")",
              "anthropicWire[\"max_tokens\"]"
            ]
          }
        ],
        "java": [
          {
            "path": "generated/fixtures/java/WireOptions.java",
            "snippets": [
              "public Map<String, Object> toWire(String provider)",
              "String wireName = null;",
              "if (target.equals(\"openai\")) { wireName = \"max_completion_tokens\"; }",
              "if (target.equals(\"anthropic\")) { wireName = \"max_tokens\"; }",
              "if (wireName != null && this.temperature != null)"
            ]
          }
        ],
        "rust": [
          {
            "path": "generated/fixtures/rust/wire_options.rs",
            "snippets": [
              "pub fn to_wire(&self, provider: &str) -> serde_json::Value",
              "(\"maxOutputTokens\", std::collections::HashMap::from([(\"openai\", \"max_completion_tokens\"), (\"anthropic\", \"max_tokens\")]))",
              "(\"temperature\", std::collections::HashMap::from([(\"openai\", \"temperature\")]))",
              "if let Some(wire_name) = mapping.get(provider) {",
              "result.insert(wire_name.to_string(), value)"
            ]
          }
        ],
        "swift": [
          {
            "path": "generated/fixtures/swift/Sources/TypraFixtures/wire_options.swift",
            "snippets": [
              "public func toWire(_ provider: String, context: SaveContext = SaveContext()) throws -> [String: Any]",
              "case \"openai\": wireNameMaxOutputTokens = \"max_completion_tokens\"",
              "case \"anthropic\": wireNameMaxOutputTokens = \"max_tokens\"",
              "default: wireNameTemperature = nil",
              "if let wireKey = wireNameTemperature, let value = self.temperature"
            ]
          }
        ]
      }
    },
    {
      "id": "scalar-coercion",
      "description": "FixtureReference supports the string shorthand sample and expands it into id plus a stable label.",
      "evidence": {
        "json-ast": [
          {
            "path": "generated/fixtures/json-ast/model.json",
            "snippets": [
              "\"scalar\": \"string\""
            ]
          }
        ],
        "typescript": [
          {
            "path": "generated/fixtures/typescript/fixture-reference.ts",
            "snippets": [
              "if (typeof data === \"string\")",
              "instance.id = data as string;",
              "instance.label = \"coerced reference\";"
            ]
          }
        ],
        "python": [
          {
            "path": "generated/fixtures/python/_FixtureReference.py",
            "snippets": [
              "if isinstance(data, str):",
              "instance.id = data",
              "instance.label = \"coerced reference\""
            ]
          }
        ],
        "csharp": [
          {
            "path": "generated/fixtures/csharp/FixtureReference.cs",
            "snippets": [
              "if (doc.RootElement.ValueKind != JsonValueKind.Object)",
              "string stringValue => new Dictionary<string, object?>",
              "[\"label\"] = \"coerced reference\""
            ]
          }
        ],
        "go": [
          {
            "path": "generated/fixtures/go/fixture_reference.go",
            "snippets": [
              "case string:",
              "expansion := map[string]interface{}{\"id\": v, \"label\": \"coerced reference\"}",
              "return LoadFixtureReference(expansion, ctx)"
            ]
          }
        ],
        "java": [
          {
            "path": "generated/fixtures/java/FixtureReference.java",
            "snippets": [
              "if (data instanceof String) {",
              "result.id = String.valueOf(data);",
              "result.label = \"coerced reference\";"
            ]
          }
        ],
        "rust": [
          {
            "path": "generated/fixtures/rust/fixture_reference.rs",
            "snippets": [
              "if let Some(s) = value.as_str()",
              "label: Some(\"coerced reference\".to_string())"
            ]
          }
        ],
        "swift": [
          {
            "path": "generated/fixtures/swift/Sources/TypraFixtures/fixture_reference.swift",
            "snippets": [
              "if let scalar = data as? String {",
              "instance.id = try TypraRuntime.string(scalar, field: \"id\")",
              "instance.label = \"coerced reference\""
            ]
          }
        ]
      }
    }
  ]
}
